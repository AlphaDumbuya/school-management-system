# ============================================================================
# SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# SECURITY WARNING: This file should NEVER be committed to version control.
# Always use .env for sensitive credentials and .env.example for templates.
# The .env file is already listed in .gitignore to prevent accidental commits.
#
# ============================================================================

# ============================================================================
# EXTERNAL SERVICES - SENSITIVE CONFIGURATION
# ============================================================================
# These variables contain API keys and credentials for external services.
# Keep these values secure and rotate them regularly.

# Brevo Email Service (REQUIRED - Transactional & Marketing Emails)
# Purpose: Send email notifications for grades, attendance, fees, enrollment
# Setup: https://www.brevo.com/
# How to get API key: Go to https://app.brevo.com/settings/keys/api
# Documentation: https://developers.brevo.com/
# Required: YES - Needed for all email notifications
BREVO_API_KEY=xkeysib-YOUR_ACTUAL_API_KEY_HERE
BREVO_SENDER_EMAIL=info@wiskulsl.com
BREVO_SENDER_NAME=WiSkul
BREVO_SENDER_PHONE=+1-555-123-4567

# UploadThing File Upload Service (OPTIONAL - Alternative to S3)
# Purpose: Secure cloud storage for student documents, certificates, imports
# Setup: https://uploadthing.com/
# How to get credentials: Create account and get from dashboard
# Documentation: https://docs.uploadthing.com/
# Required: NO - Can use local or S3 storage instead
UPLOADTHING_API_KEY=sk_live_YOUR_API_KEY_HERE
UPLOADTHING_APP_ID=YOUR_APP_ID_HERE
UPLOADTHING_SECRET=YOUR_SECRET_HERE

# Monime Online Payments (OPTIONAL until you go live with fee payments)
# Purpose: accept mobile money, card, bank & digital wallet fee payments (Sierra Leone)
# Setup: https://monime.io  → Developer → Personal Access Tokens & Space list
# Required: only if online fee payment is enabled
MONIME_ACCESS_TOKEN=mon_live_or_test_xxxxxxxxxxxx
MONIME_SPACE_ID=spc-xxxxxxxxxxxx
MONIME_WEBHOOK_SECRET=your_webhook_signing_secret
# MONIME_BASE_URL=https://api.monime.io

# File Storage Configuration (REQUIRED)
# Options: 'local' (development) or 's3' (production)
# Local: Files stored in ./storage directory
# S3: Files stored in S3-compatible service (AWS S3, MinIO, DigitalOcean Spaces)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
PUBLIC_URL=http://localhost:3000

# S3-Compatible Storage (Required if STORAGE_PROVIDER=s3)
# Works with: AWS S3, MinIO, DigitalOcean Spaces, Wasabi, Backblaze B2
# AWS S3 Setup: https://aws.amazon.com/s3/
# MinIO Setup: https://min.io/
# DigitalOcean Spaces: https://www.digitalocean.com/products/spaces
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_S3_BUCKET=your-bucket-name
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com  # Uncomment for S3-compatible services
# S3_REGION=us-east-1  # Alternative to AWS_REGION
# S3_ACCESS_KEY_ID=YOUR_KEY  # Alternative to AWS_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=YOUR_SECRET  # Alternative to AWS_SECRET_ACCESS_KEY
# S3_BUCKET=your-bucket  # Alternative to AWS_S3_BUCKET

# Neon PostgreSQL Database (REQUIRED - Application Data Storage)
# Purpose: Store all school data (students, grades, attendance, etc.)
# Setup: https://neon.tech/
# How to get connection string: Create project in Neon dashboard
# Documentation: https://neon.tech/docs/
# Required: YES - Critical for all data persistence
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@neon.tech/dbname?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=300000
DATABASE_CONNECTION_TIMEOUT=30000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Node Environment
# Options: development, staging, production
NODE_ENV=development

# Server Port
PORT=3000

# JWT Authentication (REQUIRED - Change in production!)
# Generate secure secrets: openssl rand -base64 32
# Minimum recommended length: 32 characters
# These MUST be changed from defaults in production
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars_required
JWT_EXPIRY=30m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production_min_32_chars_required
REFRESH_TOKEN_EXPIRY=7d

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
# Relying Party ID = the site domain passkeys are bound to (no scheme/port).
WEBAUTHN_RP_ID=www.wiskulsl.com
# Web/PWA origin accepted during ceremonies.
WEBAUTHN_ORIGIN=https://www.wiskulsl.com
# Native Android origin, derived from the RELEASE signing cert:
#   android:apk-key-hash:<base64url-sha256-of-release-cert>
# Leave blank until the release keystore exists + assetlinks.json is published.
# Get the fingerprint: keytool -list -v -keystore <release.jks> -alias <alias>
# then base64url-encode the SHA-256 bytes. See docs/PASSKEYS.md.
WEBAUTHN_ANDROID_ORIGIN=

# Two-factor (TOTP) issuer label shown in authenticator apps.
TOTP_ISSUER=WiSkul

# Logging Configuration
LOG_LEVEL=debug

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_ENV=development

# ============================================================================
# CACHE & MESSAGE QUEUE (Optional but Recommended)
# ============================================================================

# Redis Cache Configuration (for session and performance caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration (for async message processing)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_VHOST=/

# ============================================================================
# EMAIL NOTIFICATION SETTINGS
# ============================================================================

EMAIL_FROM=noreply@school.com
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=5000

# ============================================================================
# OPTIONAL - SMS SERVICE (For future SMS integration)
# ============================================================================
# Currently disabled - will be implemented in future phases

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=placeholder_not_configured
TWILIO_AUTH_TOKEN=placeholder_not_configured
TWILIO_PHONE_NUMBER=+1-555-123-4567

# ============================================================================
# OPTIONAL - PAYMENT GATEWAY (For future online payment integration)
# ============================================================================
# Currently disabled - will be implemented in future phases

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=placeholder_not_configured
STRIPE_PUBLIC_KEY=placeholder_not_configured

# ============================================================================
# SYSTEM SECURITY SETTINGS
# ============================================================================

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
SESSION_TIMEOUT=30m
ATTENDANCE_THRESHOLD=75
PASSWORD_EXPIRY_DAYS=90

# CORS Configuration (allowed origins for API requests)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SECURE_COOKIE=false
SAME_SITE_COOKIE=lax

# ============================================================================
# OPTIONAL - MONITORING & ANALYTICS
# ============================================================================
# Configure if using external monitoring services

SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Cron expression for backup schedule (0 2 * * * = 2 AM daily)
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_SERVICE=true
ENABLE_SMS_SERVICE=false
ENABLE_PAYMENT_GATEWAY=false
ENABLE_ANALYTICS=true
ENABLE_ADVANCED_FEATURES=true
