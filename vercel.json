{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "buildCommand": "(cd backend && ../node_modules/.bin/tsup) && (cd frontend && ../node_modules/.bin/vite build)",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=(self)"
      }
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/dist/**"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1"
  }
}

