{
  "version": 2,
  "buildCommand": "cd backend && npm install --legacy-peer-deps && npm run build && cd ../frontend && npm install --legacy-peer-deps && npx vite build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'skipping root install'",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "backend/dist/**"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
