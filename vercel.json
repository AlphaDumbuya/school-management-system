{
  "version": 2,
  "installCommand": "echo 'deps installed per workspace in build.sh'",
  "buildCommand": "bash ./build.sh",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "backend/dist/**"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
