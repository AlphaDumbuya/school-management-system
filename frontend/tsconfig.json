{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // No `baseUrl` needed: with moduleResolution "bundler", TypeScript resolves
    // these path aliases relative to this tsconfig's location. Avoids the TS 7.0
    // `baseUrl` deprecation without needing `ignoreDeprecations`.
    "paths": {
      "@appTypes/*": ["./src/types/*"],
      "@appTypes": ["./src/types/index"],
      "@config/*": ["./src/config/*"],
      "@services/*": ["./src/services/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@store/*": ["./src/store/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"],
      "@router/*": ["./src/router/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
