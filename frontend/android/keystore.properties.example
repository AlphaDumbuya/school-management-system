# Copy to keystore.properties (which is gitignored) and fill in real values.
# Generate a keystore first (see docs/ANDROID_RELEASE.md):
#   keytool -genkey -v -keystore wiskul-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias wiskul
#
# storeFile is relative to the android/ directory (or an absolute path).
storeFile=wiskul-release.jks
storePassword=CHANGE_ME
keyAlias=wiskul
keyPassword=CHANGE_ME
