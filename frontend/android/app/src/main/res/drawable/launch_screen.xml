<?xml version="1.0" encoding="utf-8"?>
<!--
  WiSkul native launch screen.

  Designed to be visually identical to the animated web splash (index.html):
  a WiSkul logo inside a white rounded tile, centered on the brand-blue
  background. This makes the native-launch → web-splash handoff seamless (no
  white flash, no jump), so it reads as one continuous splash screen before the
  login screen appears.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand-blue full-bleed background (matches web splash + status bar). -->
    <item android:drawable="@color/splashBackground" />

    <!-- Centered white rounded tile holding the logo. -->
    <item android:width="132dp" android:height="132dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Logo, inset inside the tile. -->
    <item android:width="96dp" android:height="96dp" android:gravity="center">
        <bitmap
            android:src="@drawable/ic_logo"
            android:gravity="center" />
    </item>
</layer-list>
