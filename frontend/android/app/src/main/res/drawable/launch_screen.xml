<?xml version="1.0" encoding="utf-8"?>
<!--
  WiSkul native launch screen (pre-Android-12).

  Intentionally just the brand-blue background — no logo/white box. The custom
  animated HTML splash (index.html) provides the branded logo animation once the
  WebView paints, so the whole startup is: blue → animated splash → login, with
  no white flash and no duplicate/static logo.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground" />
</layer-list>
