<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent splash icon. Used on Android 12+ so the system splash shows
  ONLY the brand-blue background (no white launcher-icon box), handing straight
  over to the custom animated HTML splash once the WebView paints.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
