<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Brand-blue WINDOW background so the WebView paints on blue (not a
             white flash) between the native launch screen and the HTML splash.
             Do NOT set android:background here: in a theme it becomes the default
             background of EVERY view that has none, which painted the native
             <select> dropdown dialog (and its list) solid blue. -->
        <item name="android:windowBackground">@color/splashBackground</item>
    </style>


    <!--
      Launch theme.

      Goal: NO white system-splash box — go straight from a brand-blue screen to
      the custom animated HTML splash.

      Pre-Android-12: uses @drawable/launch_screen (blue background; the icon
      layer there is intentionally omitted below so it's just blue).

      Android 12+ (Theme.SplashScreen): the OS ignores android:background and
      draws windowSplashScreenBackground + windowSplashScreenAnimatedIcon. We set
      the background to brand blue and the icon to a fully transparent drawable,
      so the system splash is a plain blue screen with no white icon box. It then
      hands over to the WebView (also blue) → animated HTML splash.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splashBackground</item>
        <item name="android:statusBarColor">@color/splashBackground</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/splashBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>