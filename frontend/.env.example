# Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=School Management System
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Development
VITE_DEBUG_MODE=false

# Mobile app download (marketing pages). Set to ANY value to SHOW the download
# button. The actual download is always served (and counted) via the backend at
# /api/v1/app/download, which streams the latest GitHub Release APK — set this
# to the public download URL to enable the button:
#   VITE_APK_DOWNLOAD_URL=https://www.wiskulsl.com/api/v1/app/download
VITE_APK_DOWNLOAD_URL=
# Google Play listing URL (set after publishing to Play):
VITE_PLAY_STORE_URL=

# Auto-lock: minutes of inactivity before the app logs out and requires re-auth. Default 15.
VITE_INACTIVITY_TIMEOUT_MIN=15

# Native app passkeys: hidden in the Android app by default because they only
# work once the app is release-signed AND its cert is bound to the domain via
# /.well-known/assetlinks.json (+ backend WEBAUTHN_ANDROID_ORIGIN). After you
# complete that signing setup, set this to 'true' to show the passkey button in
# the app. On plain web/PWA passkeys are always feature-detected regardless.
VITE_APK_PASSKEYS_ENABLED=false

# NOTE: Redis / Upstash is a BACKEND-only secret. It must NEVER be placed in the
# frontend env — the browser must never see it. Set REDIS_URL in backend/.env
# and in your Vercel backend project settings instead.