# Frontend Environment Variables\n# Copy this file to .env.local and update values as needed\n\n# API Configuration\nVITE_API_URL=http://localhost:3000\nVITE_API_TIMEOUT=30000\n\n# App Configuration\nVITE_APP_NAME=School Management System\nVITE_APP_VERSION=1.0.0\n\n# Features\nVITE_ENABLE_ANALYTICS=true\nVITE_ENABLE_ERROR_REPORTING=true\nVITE_ENABLE_PERFORMANCE_MONITORING=true\n\n# Development\nVITE_DEBUG_MODE=false\n
\n# Mobile app download (marketing pages). Leave empty until available.\n# Direct APK download URL. Built in cloud + published to GitHub Release android-latest:\n# https://github.com/AlphaDumbuya/school-management-system/releases/download/android-latest/wiskul.apk\nVITE_APK_DOWNLOAD_URL=\n# Google Play listing URL (set after publishing to Play):\nVITE_PLAY_STORE_URL=\n
\n# Auto-lock: minutes of inactivity before the app logs out and requires re-auth. Default 15.\nVITE_INACTIVITY_TIMEOUT_MIN=15\n