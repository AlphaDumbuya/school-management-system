{
  "name": "@school-management/backend",
  "version": "1.0.0",
  "description": "School Management System - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "knex migrate:latest",
    "db:seed": "knex seed:run",
    "create:superadmin": "tsx scripts/createSuperAdmin.ts",
    "verify:brevo": "tsx scripts/verifyBrevoApiKey.ts",
    "refactor:admin-to-principal": "tsx scripts/refactorAdminToPrincipal.ts"
  },
  "keywords": [
    "school",
    "management",
    "system",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/joi": "^17.2.2",
    "@types/nodemailer": "^8.0.0",
    "amqplib": "^0.10.3",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "brevo": "^1.0.0",
    "bullmq": "^5.78.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.3.1",
    "effect": "^3.21.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "stripe": "^22.2.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^8.56.0",
    "knex": "^3.1.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "uuid": "^11.1.1",
    "vitest": "^4.1.8"
  }
}
