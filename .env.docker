# Docker Development Environment Configuration
# Copy to .env for Docker development

# Database Configuration
DB_USER=sms_user
DB_PASSWORD=sms_password
DB_NAME=school_management

# Redis Configuration
REDIS_PASSWORD=redis_password

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Backend Configuration
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRY=30m
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRY=7d
LOG_LEVEL=debug

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_ENV=development

# External Services (fill in your actual credentials)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=School Management System

UPLOADTHING_API_KEY=your_uploadthing_api_key
UPLOADTHING_APP_ID=your_uploadthing_app_id
UPLOADTHING_SECRET=your_uploadthing_secret

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
